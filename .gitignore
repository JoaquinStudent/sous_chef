# BEGIN multi-managed: repo-directories
# multi avoids git submodules; the leading slash anchors each entry to the workspace root so it never matches a nested directory of the same name (e.g. .agents/skills). The trailing-slash form matches the repo directory; the bare form matches a root symlink/alias.
/cli/
/cli
/console/
/console
/coder-react/
/coder-react
/skills/
/skills
/super-agents/
/super-agents
/multi-react/
/multi-react
/boilersync-react/
/boilersync-react
# END multi-managed: repo-directories

# BEGIN multi-managed: generated-files
# These files are generated by multi.
.vscode/settings.json
.vscode/tasks.json
.vscode/launch.json
.vscode/extensions.json
# END multi-managed: generated-files

!instructions/AGENTS.md

# Repo-local agent skills (the bare `skills` subrepo pattern above would hide them)
!.claude/skills/
!.claude/skills/**
!.agents/skills/
!.agents/skills/**
